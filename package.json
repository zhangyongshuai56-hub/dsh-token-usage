{
  "name": "@zhangyongshuai56-hub/dsh-token-usage",
  "version": "0.1.0",
  "description": "统计 DSH 每日消耗的 Tokens，按模型分系列展示趋势与日历热力图",
  "license": "MIT",
  "author": "zhangyongshuai56-hub",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/aggregate.js && node --check lib/client.js"
  },
  "homepage": "https://github.com/zhangyongshuai56-hub/dsh-token-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyongshuai56-hub/dsh-token-usage.git"
  },
  "bugs": {
    "url": "https://github.com/zhangyongshuai56-hub/dsh-token-usage/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "analytics",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  }
}
